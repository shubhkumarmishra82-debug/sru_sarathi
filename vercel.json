{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/tour", "destination": "/tour.html" },
    { "source": "/locator", "destination": "/locator.html" },
    { "source": "/chatbot", "destination": "/chatbot.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" }
      ]
    }
  ]
}
