{
  "framework": null,
  "buildCommand": null,
  "installCommand": null,
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/tour", "destination": "/tour.html" },
    { "source": "/locator", "destination": "/locator.html" },
    { "source": "/chatbot", "destination": "/chatbot.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*).(js|css)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/assets/video/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
